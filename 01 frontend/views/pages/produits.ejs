<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="keywords" content="pain, de, vie, boulangerie, didier, shazia" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="shorcut icon" href="../../public/images/logo/Logo-vecteur-2.png">
  <link rel="stylesheet" href="../../public/css/bootstrap-5.3.8-dist/css/bootstrap.min.css">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">
  <link href="../../public/css/styles.css" rel="stylesheet">
  <title>Contact</title>
</head>

<body>
  <!-- Header &Navbar -->
  <%- include('../partials/header') %>

    <section class="home title">
      <div class='title-img position-relative mb-5 mt-5'>
        <h1
          class='text-white position-absolute top-50 start-50 end-25 translate-middle bg-black bg-opacity-50 fs-1 fw-bold text-center p-3 rounded'>
          Produits</h1>
      </div>
    </section>


    <section class="produits text-center mt-5" style="margin-top: 1000px;">
      <div class="container mt-5">
        <div class="row g-4 mt-5 justify-content-center">
          <div class="col-12 col-sm-6 col-md-6 col-lg-6">
            <div class="card border-0" style="background-color: #FCF0E4">
              <a href="./pain.html"><img class="card-img-top img-fluid w-50 rounded mx-auto d-block"
                  src="../../public/images/produits/Plusieurs-Pains-V2.png" alt="Pain Artisanal"></a>
              <div class="card-body mt-3" style="background-color: #f0d1a0">
                <h5 class="card-title">Pain Artisanal</h5>
                <p class="card-text">Pain artisanal à l'ancienne</p>
              </div>
            </div>
          </div>
          <div class="col-12 col-sm-6 col-md-6 col-lg-6">
            <div class="card border-0" style="background-color: #FCF0E4">
              <a href="./pizza.html"><img src="../../public/images/produits/Pizzas-ed.jpg"
                  class="card-img-top img-fluid rounded w-50 mx-auto d-block" alt="Pizzas"></a>
              <div class="card-body mt-3" style="background-color: #f0d1a0">
                <h5 class="card-title">Pizzas</h5>
                <p class="card-text">Pizzas à la sauce courgette ou potimarron</p>
              </div>
            </div>
          </div>
          <div class="col-12 col-sm-6 col-md-6 col-lg-6">
            <div class="card border-0" style="background-color: #FCF0E4">
              <a href="./brioche.html"><img src="../../public/images/produits/Brioche-grande.jpg"
                  class="card-img-top img-fluid w-50 rounded mx-auto d-block" alt="Brioche"></a>
              <div class="card-body mt-3" style="background-color: #f0d1a0">
                <h5 class="card-title">Brioche</h5>
                <p class="card-text">Faite maison</p>
              </div>
            </div>
          </div>
          <div class="col-12 col-sm-6 col-md-6 col-lg-6">
            <div class="card border-0" style="background-color: #FCF0E4">
              <a href="./viennoiserie.html"><img src="../../public/images/produits/Viennoiseries.jpg"
                  class="card-img-top img-fluid w-50 rounded mx-auto d-block" alt="Viennoiseries"></a>
              <div class="card-body mt-3" style="background-color: #f0d1a0">
                <h5 class="card-title">Viennoiseries</h5>
                <p class="card-text">Des deliceuses viennoiseries artisanales</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <%- include('../partials/footer') %>

</body>
<script src="../../public/css/bootstrap-5.3.8-dist/js/bootstrap.min.js"></script>

</html>