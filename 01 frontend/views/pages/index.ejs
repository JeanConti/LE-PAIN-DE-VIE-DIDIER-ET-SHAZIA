<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="keywords" content="pain, de, vie, boulangerie, didier, shazia" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="shorcut icon" href="/images/logo/Logo-vecteur-2.png">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">
  <link href="/css/styles.css" rel="stylesheet">
  <link rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&icon_names=breakfast_dining" />
  <title>Home - Le Pain de Vie</title>
</head>

<body>
  <%- include('../partials/header') %>

    <!-- Section Home -->
    <section class="home pt-1">
      <div class="container-fluid mt-5" style='max-width: 100%; height: 100vh; padding: 0;'>

        <!-- Carousel -->
        <div id="carouselExampleIndicators" class="carousel slide carousel-fade mx-auto position-relative p-0"
          style="max-width: 100%; height: 100vh;" data-bs-ride="carousel" data-bs-interval="3000">
          <div class="carousel-indicators">
            <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="0" class="active"
              aria-current="true" aria-label="Slide 1"></button>
            <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="1"
              aria-label="Slide 2"></button>
            <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="2"
              aria-label="Slide 3"></button>

          </div>

          <!-- Texte centré au-dessus de toutes les images -->
          <div class="position-absolute top-50 start-50 translate-middle text-center w-50 w-md-50 w-lg-50"
            style="z-index: 10;">
            <h1 class='text-light fs-3 fs-md-2 fs-lg-1 fw-bold bg-black bg-opacity-50 p-2 p-md-3 rounded mb-2 mb-md-3'>
              Le Pain de Vie
            </h1>
            <p class='text-light fs-6 fs-md-5 fw-bold bg-black bg-opacity-50 p-2 p-md-3 rounded'>
              Pain artisanal à l'ancienne
            </p>
          </div>

          <div class="carousel-inner h-100">
            <div class="carousel-item active h-100">
              <img src="../../public/images/carousel/Mains-Croissant-2.png" class="d-block w-100 h-100 "
                style="object-fit: cover;" alt="Boulangerie artisanale">
            </div>
            <div class="carousel-item h-100">
              <img src="../../public/images/carousel/Assortiment-de-viennoiseries-fraîches.png"
                class="d-block w-100 h-100 " style="object-fit: cover;" alt="Boulangerie artisanale">
            </div>
            <div class="carousel-item h-100">
              <img src="../../public/images/carousel/Biscuits aux pépites de chocolat fraîchement cuits.png"
                class="d-block w-100 h-100" style="object-fit: cover;" alt="Produits de boulangerie">
            </div>
          </div>
          <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleIndicators"
            data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden text-white">Previous</span>
          </button>
          <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleIndicators"
            data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden text-white">Next</span>
          </button>
        </div>
    </section>

    <!-- Section Stats -->
    <section class='mt-5'>
      <div class="container py-5">
        <div class="row g-4 justify-content-center">
          <div class='col-12 col-sm-6 col-lg-3 wow fadeIn' data-bs-delay='0.1s'>
            <div class="card-stats text-center py-4 py-md-5 border-0 h-100">
              <div class="card-body">
                <i class="fa fa-certificate fa-3x fa-md-4x mb-3 mb-md-4" style="color: #6d3200;"></i>
                <h5 class="card-title fw-bold">Années d'expérience</h5>
                <h1 class="display-5 mb-0" data-toggle="counter-up">23</h1>
              </div>
            </div>
          </div>

          <div class='col-12 col-sm-6 col-lg-3 wow fadeIn' data-bs-delay='0.2s'>
            <div class="card-stats text-center py-4 py-md-5 border-0 h-100">
              <div class="card-body">
                <i class="fa fa-users fa-3x fa-md-4x mb-3 mb-md-4" style="color: #6d3200;"></i>
                <h5 class="card-title fw-bold">Professionnels qualifié</h5>
                <h1 class="display-5 mb-0" data-toggle="counter-up">4</h1>
              </div>
            </div>
          </div>

          <div class='col-12 col-sm-6 col-lg-3 wow fadeIn' data-bs-delay='0.3s'>
            <div class="card-stats text-center py-4 py-md-5 border-0 h-100">
              <div class="card-body">
                <i class="fa fa-bread-slice fa-3x fa-md-4x mb-3 mb-md-4" style="color: #6d3200;"></i>
                <h5 class="card-title fw-bold">Produits BIO total</h5>
                <h1 class="display-5 mb-0" data-toggle="counter-up">27</h1>
              </div>
            </div>
          </div>

          <div class='col-12 col-sm-6 col-lg-3 wow fadeIn' data-bs-delay='0.4s'>
            <div class="card-stats text-center py-4 py-md-5 border-0 h-100">
              <div class="card-body">
                <i class="fa fa-cart-plus fa-3x fa-md-4x mb-3 mb-md-4" style="color: #6d3200;"></i>
                <h5 class="card-title fw-bold">Pain vendu par semaine</h5>
                <h1 class="display-5 mb-0" data-toggle="counter-up">1300</h1>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Section About -->
    <section class='about mt-5 mb-5 pt-5'>
      <div class='div class="container-xxl py-6'>
        <div class="container">
          <div class="row g-5">
            <div class="col-lg-6 fadeInUp" data-bs-delay="0.1s">
              <div class="row img-twice position-relative h-75">
                <div class="col-6">
                  <img class="img-fluid rounded" src="../../public/images/galerie/Plusieurs-Pains.png" alt="">
                </div>
                <div class="col-6 align-self-end">
                  <img class="img-fluid rounded" src="../../public/images/galerie/Pain-01.png" alt="">
                </div>
              </div>
            </div>
            <div class="col-lg-6 fadeInUp" data-bs-delay="0.1s">
              <div class="h-100">
                <p class="fw-bold text-uppercase" style="color: #6d3200;">À propos de nous</p>
                <h1 class="display-6 mb-5">Nous Cuisons <br> Avec Amour & Passion</h1>
                <p>Depuis plusieurs années, notre boulangerie vous accueille chaque jour avec une même passion :
                  celle du pain authentique, façonné dans le respect des traditions artisanales.</p>
                <p>Nous sélectionnons avec soin des ingrédients de qualité, travaillés sur place par notre équipe de
                  boulangers pour vous offrir des pains croustillants, des viennoiseries dorées et des pâtisseries
                  gourmandes, préparés chaque matin.</p>
                <p>Plus qu’un commerce de proximité, notre boulangerie est un lieu de partage, où le goût, la
                  convivialité
                  et le savoir-faire se rencontrent pour accompagner vos moments du quotidien.</p>
                <div class="row g-3 mb-3">
                  <div class="col-12 col-sm-6">
                    <i class="fa fa-check me-2" style="color: #6d3200;"></i>Produits bio de qualité
                  </div>
                  <div class="col-12 col-sm-6">
                    <!-- <i class="fa fa-check me-2" style="color: #6d3200;"></i>Livraison a domicile -->
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

    </section>



    <!-- Section Best Bakery -->
    <section class='best-bakery mt-5 pt-5'>
      <div class='container-xxl bg-light my-5 py-5 pt-0'>
        <div class="container">
          <div
            class="row text-light align-items-center justify-content-center rounded p-4 p-md-5 my-5 mt-0 wow fadeInUp"
            data-bs-delay="0.1s" style="background-color: #6d3200;">
            <div class="col-12 col-lg-6 text-center mb-4 mb-lg-0">
              <img src="../../public/images/logo/Logo-vecteur.png" alt="Le Pain de Vie Logo"
                class='img-fluid w-50 w-md-25 bg-light rounded'>
            </div>
            <div class="col-12 col-lg-6 text-center">
              <h1 class="display-6 fs-3 fs-md-4 fs-lg-5 text-light fw-bold mb-0">
                Pain artisanal BIO a l'ancienne
              </h1>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Produits -->
    <section class='produits mt-5 mb-5 pt-5'>
      <div class="container-xxl my-6 py-6 pt-0">
        <div class="container">
          <div class="text-center mx-auto mb-5 wow fadeInUp" data-bs-delay="0.1s" style="max-width: 500px;">
            <p class=" fw-bold text-uppercase mb-2" style="color: #6d3200;">Nos produits</p>
            <h1 class="display-6 mt-4 mb-4">Explorez les produits <br> de notre boulangerie</h1>
          </div>
          <div class="row g-4">
            <div class="col-lg-4 col-md-6 wow fade-inUp" data-bs-delay="0.1s">
              <div class="product-item d-flex flex-column bg-white rounded overflow-hidden h-100">
                <div class="text-center p-4">
                  <div class="d-inline-block border border-light rounded-pill px-3 mb-3">5,90€ - 9,20</div>
                  <h3 class="mb-3">Pain</h3>
                  <span>Pain artisanal fait avec passion!</span>
                </div>
                <div class="position-relative mt-auto">
                  <img class="img-fluid" src="../../public/images/produits/Plusieurs-Pains-V2.png" alt="">
                  <div class="product-overlay">
                    <a class="btn btn-lg-square btn-outline-light rounded-circle text-light" href="./pain.html"><i
                        class="fa fa-eye"></i></a>
                  </div>
                </div>
              </div>
            </div>
            <div class="col-lg-4 col-md-6 wow fadeInUp" data-bs-delay="0.3s">
              <div class="product-item d-flex flex-column bg-white rounded overflow-hidden h-100">
                <div class="text-center p-4">
                  <div class="d-inline-block border border-warning rounded-pill px-3 mb-3">3,90€
                  </div>
                  <h3 class="mb-3">Pizza</h3>
                  <span>Pizza de qualité</span>
                </div>
                <div class="position-relative mt-auto">
                  <img class="img-fluid" src="../../public/images/produits/Pizzas-ed.jpg" alt="">
                  <div class="product-overlay">
                    <a class="btn btn-lg-square btn-outline-light rounded-circle text-light" href="./pizza.html"><i
                        class="fa fa-eye"></i></a>
                  </div>
                </div>
              </div>
            </div>
            <div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="0.5s">
              <div class="product-item d-flex flex-column bg-white rounded overflow-hidden h-100">
                <div class="text-center p-4">
                  <div class="d-inline-block border border-warning rounded-pill px-3 mb-3 align-items-center">1,50€ -
                    1,90€
                  </div>
                  <h4 class="mb-3">Viennoiseries</h4>
                  <span>Délicieuses viennoiseries</span>
                </div>
                <div class="position-relative mt-auto">
                  <img class="img-fluid" src="../../public/images/produits/Viennoiseries.jpg" alt="">
                  <div class="product-overlay">
                    <a class="btn btn-lg-square btn-outline-light rounded-circle text-light"
                      href="./viennoiseries.html"><i class="fa fa-eye"></i></a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Services -->
    <section class="services mt-5 mb-5 pt-5">
      <div class='div class="container-xxl py-6'>
        <div class="container">
          <div class="row g-5">
            <div class="col-lg-6 fadeInUp" data-bs-delay="0.1s">
              <div class="h-100">
                <p class="fw-bold text-uppercase" style="color: #6d3200;">Nos services</p>
                <h1 class="display-6 mb-4">Que pouvons nous vous offrir ?</h1>
                <p>Nous proposons une large gamme de pains, viennoiseries et douceurs artisanales et biologiques,
                  élaborées à partir de farines de qualité, de levain naturel et de méthodes de fabrication
                  traditionnelles.</p>
                <p>Nous assurons également la vente <strong>directe</strong>, ainsi qu’une présence régulière sur les
                  marchés locaux.
                  À l’écoute de nos clients, nous privilégions le savoir-faire, la proximité et le respect des produits
                  pour offrir des pains sains, savoureux et authentiques.</p>
              </div>
            </div>
            <div class="col-lg-6 fadeInUp" data-bs-delay="0.1s">
              <div class="row img-twice position-relative h-100">
                <div class="col-6">
                  <img class="img-fluid rounded" src="../../public/images/galerie/Pain-01.png " alt="">
                </div>
                <div class="col-6 align-self-end">
                  <img class="img-fluid rounded" src="../../public/images/galerie/Plusieurs-Pains.png" alt="">
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>




    <%- include('../partials/footer') %>
</body>
<script src="../../public/css/bootstrap-5.3.8-dist/js/bootstrap.min.js"></script>

</html>